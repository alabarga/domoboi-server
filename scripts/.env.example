# domoboi server
DOMOBOI_API_URL=http://suara.domoboi.es
DOMOBOI_API_TOKEN=your-edge-api-token-here

# Tuya device mapping: {"tuya_device_id": "domoboi_device_id"}
# The domoboi_device_id must match Device.device_id in the domoboi admin.
# For Tuya devices the two IDs are typically the same.
TUYA_DEVICE_MAP={"bf9903ace56236ba42go1n": "bf9903ace56236ba42go1n", "bf19ab92a85a829792vpxr": "bf19ab92a85a829792vpxr"}

# Tuya OpenAPI credentials (from Tuya IoT Platform > Cloud > Project)
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here
TUYA_REGION=eu

# Seconds between live polls (default: 60)
TUYA_POLL_INTERVAL=60
